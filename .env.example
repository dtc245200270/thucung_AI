# =============================================================================
# PETCARE PRO AI - TỆP CẤU HÌNH MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép tệp này thành .env và điền các giá trị thực tế của bạn:
# cp .env.example .env
# =============================================================================

# 1. CỔNG MÁY CHỦ BACKEND & FRONTEND
PORT=5000
APP_URL=http://localhost:5173

# 2. CẤU HÌNH DỊCH VỤ GỬI THƯ ĐIỆN TỬ (SMTP CONFIGURATION)
# Khi thiết lập đầy đủ thông tin SMTP dưới đây, backend sẽ gửi email thật chứa liên kết khôi phục.
#
# Ví dụ 1: Sử dụng Gmail SMTP
# - SMTP_HOST=smtp.gmail.com
# - SMTP_PORT=587
# - SMTP_SECURE=false
# - SMTP_USER=your_account@gmail.com
# - SMTP_PASS=your_gmail_app_password (Mật khẩu ứng dụng 16 chữ số tạo từ Google Account)
#
# Ví dụ 2: Sử dụng SendGrid / Resend / Brevo / Mailgun / Mailtrap
# - SMTP_HOST=smtp.resend.com
# - SMTP_PORT=465
# - SMTP_SECURE=true
# - SMTP_USER=resend
# - SMTP_PASS=re_your_api_key_here
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PetCare PRO AI <no-reply@petcare.ai>"

# 3. MÃ BÍ MẬT KÝ TOKEN XÁC THỰC (JWT SECRET KEY)
JWT_SECRET=your_jwt_secret_key_change_in_production

# 4. CẤU HÌNH AI CỤC BỘ QUA OLLAMA (LOCAL AI ENGINE)
# Không sử dụng API bên ngoài, chạy hoàn toàn nội bộ
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# 5. CHẾ ĐỘ THỬ NGHIỆM PHÁT TRIỂN NỘI BỘ (DEVELOPMENT TESTING ONLY)
# Đặt thành true để in liên kết khôi phục ra console máy chủ khi chưa kết nối SMTP thật.
# Mặc định: false (sẽ báo lỗi cấu hình nếu cố tình gửi mà chưa điền thông tin SMTP).
DEV_MODE_ALLOW_CONSOLE_EMAIL=false

