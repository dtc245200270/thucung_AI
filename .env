# PetCare PRO AI Local Environment
PORT=5000
APP_URL=http://localhost:5173

# Cấu hình máy chủ gửi thư SMTP (Điền thông tin tài khoản SMTP thực tế của bạn tại đây)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PetCare PRO AI <no-reply@petcare.ai>"

# Cho phép in liên kết khôi phục ra console máy chủ khi kiểm thử nội bộ nếu chưa cấu hình SMTP
DEV_MODE_ALLOW_CONSOLE_EMAIL=true

# JWT & AI Cục bộ
JWT_SECRET=fallback-secret-key-for-dev

# Cấu hình Ollama tập trung (không gán cứng tại nhiều nơi)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Mô hình nhận ảnh (Vision) — dùng cho AiVisionScannerView
OLLAMA_VISION_MODEL=moondream:1.8b
# Mô hình văn bản — dùng dịch thuật / chatbot Dr. Paw (qwen2.5:1.5b)
OLLAMA_TEXT_MODEL=qwen2.5:1.5b
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
# Mô hình embedding RAG cục bộ (embeddinggemma)
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_CHAT_TIMEOUT_MS=30000
